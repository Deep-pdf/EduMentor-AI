# ==============================================================================
# EduMentor AI Configuration Environment Template
# ==============================================================================
# Copy this file to a new file named `.env` and fill in the values below.
# DO NOT commit the `.env` file containing real credentials to version control.

# Groq Cloud API credentials
GROQ_API_KEY=your_groq_api_key_here

# LLM model name (e.g. llama3-70b-8192, llama3-8b-8192)
MODEL_NAME=llama3-70b-8192

# Logging levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Streamlit application client title
APP_NAME=EduMentor AI

# Maximum file upload size allowed in Megabytes
UPLOAD_LIMIT=200

# Directory path where ChromaDB collections will persist
CHROMA_DB_PATH=vector_db

# RAG Configuration Settings
EMBEDDINGS_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
COLLECTION_NAME=edumentor_collection
